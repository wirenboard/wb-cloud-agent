[Unit]
Description=Wiren Board Cloud Agent (%i)
Wants=network-online.target mosquitto.service
After=network-online.target mosquitto.service
# no start limit: once it is hit, systemd stops restarting the agent until a reboot
StartLimitIntervalSec=0
ConditionPathIsDirectory=/etc/wb-cloud-agent/providers/%i

[Service]
ExecStartPre=/usr/lib/wb-cloud-agent/check-certs.sh
ExecStart=/usr/bin/wb-cloud-agent run-daemon %i
Restart=on-failure
RestartSec=10
RestartSteps=5
RestartMaxDelaySec=300
RestartPreventExitStatus=2 6
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
